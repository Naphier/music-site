# Copy this file to terraform.tfvars for local use.
# Do not commit terraform.tfvars because it may contain local or sensitive values.

aws_region       = "us-east-1"
site_bucket_name = "YOUR_EXISTING_SITE_BUCKET"

# Leave empty for mock mode while testing the CloudFront-hosted site.
track_bucket_name   = ""
track_bucket_region = "us-east-1"
track_prefix        = ""
enable_mock_mode    = true

# Stage 1: keep custom domain disabled and test the CloudFront default URL.
custom_domain_name                = "music.naplandgames.com"
create_custom_domain_certificate = false
enable_custom_domain             = false
custom_domain_certificate_arn    = ""

# Stage 2: set create_custom_domain_certificate=true, apply, and add the
# certificate validation records in JaguarPC DNS.

# Stage 3: after ACM reports the certificate as issued, set
# enable_custom_domain=true and add the CNAME output in JaguarPC DNS.
